{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Next.js: dev",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test probe-search-memories",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "runtimeArgs": ["scripts/probe-search-memories.mjs"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "next:dev",
      "postDebugTask": "stop:next:dev"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "List memory questions",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "runtimeArgs": ["scripts/list-memory-questions.mjs"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "next:dev",
      "postDebugTask": "stop:next:dev"
    }
    ]
}

      "version": 1,
      "versionNonce": 908807759,
      "isDeleted": false,
      "text": "• `listChats()` fetches from SQLite catalog\n• Active conversation highlighted (`chatId === id`)\n• Clicking any recent item invokes `switchChat(id)`\n• `chatOrder` increment triggers auto-refresh on\n  new message streams or delete\n• `Load more` paginates using cursor",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "index": "b5117",
      "boundElements": [],
      "updated": 1787584530661,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "• `listChats()` fetches from SQLite catalog\n• Active conversation highlighted (`chatId === id`)\n• Clicking any recent item invokes `switchChat(id)`\n• `chatOrder` increment triggers auto-refresh on\n  new message streams or delete\n• `Load more` paginates using cursor",
      "autoResize": true,
      "lineHeight": 1.35
    },

    {
      "id": "sidebar_exp_assistant_msg_txt",
      "type": "text",
      "x": -3395,
      "y": 2435,
      "width": 522.6,
      "height": 70.2,
      "angle": 0,
      "strokeColor": "#d4d4d8",
